# Fill these with the PUBLIC values from the target Supabase project.
# Use a separate Supabase project for development; never place a service-role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_MEDIA_BUCKET=chat-media

# Optional error monitoring. Use a project DSN from your Sentry project.
VITE_SENTRY_DSN=
